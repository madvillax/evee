# Node + Hono backend. Next.js proxies browser API requests to this origin.
API_PORT=4000
API_INTERNAL_URL=http://localhost:4000
WEB_ORIGINS=http://localhost:3001

# Web authentication. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Optional. Add each additional exact public origin, comma-separated.
BETTER_AUTH_TRUSTED_ORIGINS=

# Direct Google Gemini API credentials from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Use file:local.db for local development or a libsql:// URL for Turso.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Optional. Raises GitHub search rate limits.
GITHUB_TOKEN=
REDDIT_USER_AGENT=evee/0.3 (web opportunity monitoring)

# Comma-separated feeds added to every new profile.
DEFAULT_RSS_FEEDS=

# Vercel Eve agent service (web Copilot, Telegram, schedules).
EVE_PORT=4001
EVE_INTERNAL_URL=http://localhost:4001
# Generate with: openssl rand -base64 32. Same value in Hono and Eve.
EVE_SERVICE_SECRET=

# Create a Telegram bot with BotFather. Never expose these in the browser.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# Public HTTPS origin of the Eve agent service, used to register the webhook.
EVE_PUBLIC_URL=
