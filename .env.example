# Discord Developer Portal > General Information
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# Discord Developer Portal > Bot. Keep this private; never expose it in the browser.
DISCORD_BOT_TOKEN=

# Optional: use a test server ID while developing so slash-command updates are immediate.
DISCORD_TEST_GUILD_ID=

# Railway injects PORT in production. Keep this for local Discord interaction testing.
PORT=3000

# Web authentication. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Optional. Add each additional exact public origin, comma-separated.
BETTER_AUTH_TRUSTED_ORIGINS=

# Direct Google Gemini API credentials from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Use file:local.db for local development or a libsql:// URL for Turso.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Optional. Raises GitHub search rate limits.
GITHUB_TOKEN=
REDDIT_USER_AGENT=evee/0.2 (opportunity monitoring bot)

# Comma-separated feeds added to every new profile.
DEFAULT_RSS_FEEDS=
