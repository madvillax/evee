{
  "name": "@evee/agents",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "eve build",
    "dev": "eve dev --no-ui --no-default-extensions --port 4001",
    "start": "eve start --host 0.0.0.0 --port 4001",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.36",
    "@evee/platform": "*",
    "ai": "^7.0.137",
    "eve": "0.77.0",
    "just-bash": "^3.6.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "^5.9.3",
    "tsx": "latest"
  }
}
