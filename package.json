{
  "name": "evee",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --parallel",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:bot": "bun run --cwd apps/bot dev",
    "dev:worker": "bun run --cwd apps/worker dev",
    "bot": "bun run --cwd apps/bot start",
    "worker": "bun run --cwd apps/worker start",
    "start": "bun run bot",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun packages/platform/src/db/migrate.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "latest",
    "turbo": "latest",
    "typescript": "^5.9.3"
  }
}
