{
  "name": "evee",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --parallel",
    "dev:web": "bun --cwd apps/web dev",
    "dev:bot": "BOT_MODE=polling bun --env-file=.env --env-file=apps/bot/.env.local --watch apps/bot/src/index.ts",
    "dev:worker": "MASTRA_WORKER=true bun --env-file=.env --watch apps/worker/src/index.ts",
    "bot": "BOT_MODE=polling bun --env-file=.env --env-file=apps/bot/.env.local apps/bot/src/index.ts",
    "worker": "MASTRA_WORKER=true bun --env-file=.env apps/worker/src/index.ts",
    "start": "bun apps/bot/src/index.ts",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun packages/platform/src/db/migrate.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "latest",
    "turbo": "latest",
    "typescript": "^5.9.3"
  }
}
