{
  "name": "evee",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --parallel --filter=@evee/web --filter=@evee/api --filter=@evee/worker",
    "dev:web": "npm run dev --workspace=@evee/web",
    "dev:api": "npm run dev --workspace=@evee/api",
    "dev:worker": "npm run dev --workspace=@evee/worker",
    "start": "npm run start --workspace=@evee/api",
    "start:web": "npm run start --workspace=@evee/web",
    "worker": "npm run start --workspace=@evee/worker",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx packages/platform/src/db/migrate.ts",
    "telegram:webhook": "tsx scripts/register-telegram-webhook.ts",
    "agent:info": "npm exec --workspace=@evee/agents -- eve info"
  },
  "devDependencies": {
    "@types/node": "latest",
    "drizzle-kit": "latest",
    "tsx": "latest",
    "turbo": "latest",
    "typescript": "^5.9.3"
  }
}
